// Gate 1 schema. Instants are timestamptz (UTC); date-only values use @db.Date.
// Every user-owned row carries userId; provider IDs are unique per user+provider.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  googleSubject   String    @unique
  timezone        String    @default("America/New_York") // IANA
  phoneE164       String?   @unique
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  smsOptOut       Boolean   @default(false)
  emailOptOut     Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  sessions           Session[]
  integrations       Integration[]
  events             Event[]
  tasks              Task[]
  briefings          Briefing[]
  deliveryAttempts   DeliveryAttempt[]
  inboundMessages    InboundMessage[]
  scheduledBriefings ScheduledBriefing[]
  phoneVerifications PhoneVerification[]
  preference         UserPreference?
  auditLogs          AuditLog[]
  jobExecutions      JobExecution[]
  pendingActions     PendingAction[]
  agentRuns          AgentRun[]
}

model UserPreference {
  userId            String  @id
  briefingChannel   String  @default("email") // email | sms
  morningEnabled    Boolean @default(true)
  morningTime       String  @default("08:00")
  eveningEnabled    Boolean @default(false)
  eveningTime       String  @default("19:00")
  quietHoursStart   String? // "22:00"
  quietHoursEnd     String? // "07:00"
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique // sha256 of cookie value
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  phoneE164 String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Integration {
  id            String    @id @default(cuid())
  userId        String
  provider      String // google_calendar | gmail (gmail tracks reply-check health; tokens live on google_calendar)
  status        String    @default("connected") // connected | error | reauth_required | disconnected
  lastSyncAt    DateTime? @db.Timestamptz(3)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  lastError     String?
  lastErrorAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential  IntegrationCredential?
  syncCursors SyncCursor[]

  @@unique([userId, provider])
}

model IntegrationCredential {
  integrationId   String    @id
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime? @db.Timestamptz(3)
  scope           String
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model SyncCursor {
  id            String   @id @default(cuid())
  integrationId String
  resource      String // e.g. "calendar:primary"
  cursor        String?
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, resource])
}

model Event {
  id                String    @id @default(cuid())
  userId            String
  provider          String // google_calendar | internal
  calendarId        String
  externalId        String
  title             String
  description       String?
  location          String?
  allDay            Boolean   @default(false)
  startAt           DateTime? @db.Timestamptz(3) // timed events
  endAt             DateTime? @db.Timestamptz(3)
  startDate         DateTime? @db.Date // all-day events (end exclusive)
  endDate           DateTime? @db.Date
  sourceTimezone    String?
  status            String    @default("confirmed") // confirmed | tentative | cancelled
  htmlLink          String?
  verification      String    @default("confirmed") // confirmed | inferred | suggested | stale
  externalUpdatedAt DateTime? @db.Timestamptz(3)
  lastSyncedAt      DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
  @@index([userId, startAt])
  @@index([userId, startDate])
}

model Task {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  dueAt         DateTime? @db.Timestamptz(3) // due at a specific instant
  dueDate       DateTime? @db.Date // date-only deadline
  priority      String    @default("medium") // critical | high | medium | low
  status        String    @default("open") // open | done
  category      String?
  effortMinutes Int?
  sourceType    String    @default("manual") // manual | sms | email (briefing reply) | agent | canvas | gmail (ingestion)
  sourceRef     String? // e.g. InboundMessage id
  verification  String    @default("confirmed")
  completedAt   DateTime? @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  // Imported items (Canvas). The provider owns title/dueAt/htmlLink/courseName/externalSubmittedAt;
  // the user owns notes, priority and status, which a re-sync never overwrites.
  externalProvider    String? // canvas
  externalId          String? // e.g. "assignment:12345"
  htmlLink            String?
  courseName          String?
  externalSubmittedAt DateTime? @db.Timestamptz(3)
  notes               String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalProvider, externalId])
  @@index([userId, status, dueDate])
}

model Briefing {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("adhoc") // morning | evening | adhoc | sms_today | email_today
  forDate   DateTime @db.Date
  timezone  String
  content   String // SMS text
  snapshot  Json // the persisted events/tasks used to build it
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]

  @@index([userId, createdAt])
}

model DeliveryAttempt {
  id                String    @id @default(cuid())
  userId            String
  briefingId        String?
  purpose           String    @default("briefing") // briefing | verification | reply
  channel           String    @default("sms") // sms | email
  provider          String // twilio | simulator | gmail
  to                String
  body              String
  attempt           Int       @default(1)
  // queued (created locally) -> accepted (provider took it) -> sent -> delivered
  // or failed / undelivered. Only provider responses/callbacks advance this.
  status            String    @default("queued")
  providerStatus    String?
  providerMessageId String?   @unique
  threadId          String? // Gmail thread, so replies can be matched to the briefing
  error             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefing          Briefing? @relation(fields: [briefingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model InboundMessage {
  id                String   @id @default(cuid())
  userId            String?
  channel           String   @default("sms") // sms | email
  provider          String // twilio | simulator | gmail
  providerMessageId String
  fromAddress       String // E.164 phone number or email address
  threadId          String? // Gmail thread
  body              String
  // received | processed | ignored | rejected | agent_pending (claimed, waiting for the LLM agent)
  status            String   @default("received")
  command           String?
  result            Json?
  receivedAt        DateTime @default(now()) @db.Timestamptz(3)
  // Set when an agent run starts; a run older than 10 min without finishing may be retried.
  agentStartedAt    DateTime? @db.Timestamptz(3)
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerMessageId]) // webhook idempotency
  @@index([userId, receivedAt])
  @@index([status, agentStartedAt])
}

// Changes the agent proposed. Nothing is applied until the user replies YES in the same thread.
model PendingAction {
  id                  String    @id @default(cuid())
  userId              String
  inboundMessageId    String    @unique // the reply that led to the proposal
  threadId            String?
  actions             Json // validated, normalized actions (deterministic dates already resolved)
  summary             String
  status              String    @default("pending") // pending | confirmed | cancelled | expired | superseded
  expiresAt           DateTime  @db.Timestamptz(3)
  resolvedAt          DateTime? @db.Timestamptz(3)
  resolvedByInboundId String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, threadId, status])
}

// One row per handled reply: what was asked, what the agent did, and the user's right/wrong mark.
model AgentRun {
  id               String    @id @default(cuid())
  userId           String
  inboundMessageId String    @unique
  kind             String // agent | fast_path
  input            String
  context          Json? // what the agent was given besides tools (date, zone, briefing numbers)
  zone             String
  receivedAt       DateTime  @db.Timestamptz(3) // the "now" dates were resolved against
  model            String?
  toolCalls        Json? // [{ name, input, output, isError }]
  proposedActions  Json?
  pendingActionId  String?
  reply            String?
  error            String?
  inputTokens      Int?
  outputTokens     Int?
  latencyMs        Int?
  verdict          String? // right | wrong
  note             String?
  expected         Json? // the user's "should have" on a wrong run
  markedAt         DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([verdict])
}

// One row per user + kind + local date: the claim that makes scheduled sends exactly-once.
model ScheduledBriefing {
  id            String    @id @default(cuid())
  userId        String
  kind          String // morning | evening
  forDate       DateTime  @db.Date // user-local date
  scheduledFor  DateTime  @db.Timestamptz(3) // the local time it was due, as an instant
  // pending -> sending -> sent | retrying (nextAttemptAt) | failed | skipped
  status        String    @default("pending")
  briefingId    String?   @unique
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @db.Timestamptz(3)
  error         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, forDate])
  @@index([status, nextAttemptAt])
}

// Written by the worker on every scheduler tick so the dashboard can say whether it is running.
model WorkerHeartbeat {
  id         String   @id // "scheduler"
  startedAt  DateTime @db.Timestamptz(3)
  lastTickAt DateTime @db.Timestamptz(3)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  actor      String // user | sms | email | sync | system
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model JobExecution {
  id         String    @id @default(cuid())
  userId     String?
  type       String // calendar_sync | briefing_send | email_reply_check | scheduled_briefing
  status     String    @default("running") // running | succeeded | failed
  attempt    Int       @default(1)
  error      String?
  metadata   Json?
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, startedAt])
}
