# ---- App ----
# Base URL the browser uses (OAuth redirect is built from this)
APP_URL=http://localhost:3000
# Public HTTPS URL that Twilio can reach (ngrok/cloudflared tunnel or deployment). Used for
# webhook signature validation and status callbacks. Must match the URL configured in Twilio exactly.
PUBLIC_URL=https://your-tunnel.example.com
DEFAULT_TIMEZONE=America/New_York

# ---- Database ----
DATABASE_URL=postgresql://pa:pa_local_dev@localhost:5432/productive_assistant
# Used only by `npm test` integration tests (a separate DB; it is wiped by the tests)
TEST_DATABASE_URL=postgresql://pa:pa_local_dev@localhost:5432/productive_assistant_test

# ---- Security ----
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ---- Google OAuth + Calendar ----
# Redirect URI to register: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- SMS ----
# "twilio" for real SMS, "simulator" for clearly-labeled local simulation (NOT proof of live SMS)
SMS_PROVIDER=simulator
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# E.164 number purchased in Twilio; set its inbound webhook to ${PUBLIC_URL}/api/webhooks/twilio/sms (HTTP POST)
TWILIO_FROM_NUMBER=+15555550100

# ---- AI provider (not required for Gate 1) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Email delivery (Gate 2) ----
RESEND_API_KEY=
EMAIL_FROM=briefings@example.com
